# Core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database / Redis / Celery
DATABASE_URL=postgres://localhost:5432/fomobot
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security — generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# CORS / frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# WhatsApp provider: mock (dev) | external (HTTP gateway)
WHATSAPP_PROVIDER=mock
# Dev only: enables POST /api/v1/bots/{id}/qr/simulate-scan/ for the mock provider
QR_SIMULATION=true
WHATSAPP_SERVICE_URL=http://localhost:4000
WHATSAPP_SERVICE_TOKEN=

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=FomoBot <noreply@fomobot.local>

# Observability
SENTRY_DSN=
LOG_FORMAT=verbose
