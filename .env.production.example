# ─── FomoBot production environment ────────────────────────────────
# Copy to .env on the server and fill real values.
# VPS_IP example: 203.0.113.10  → API domain: api.203.0.113.10.sslip.io

# Core — REQUIRED
DJANGO_SECRET_KEY=          # generate: openssl rand -hex 50
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=false
# VPS public hostnames (comma separated):
DJANGO_ALLOWED_HOSTS=api.<VPS_IP>.sslip.io,localhost,127.0.0.1

# Secrets — REQUIRED
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Postgres password (used by docker-compose.prod.yml):
POSTGRES_PASSWORD=          # generate: openssl rand -hex 24

# CORS / frontend — REQUIRED
CORS_ALLOWED_ORIGINS=https://app.<VPS_IP>.sslip.io
FRONTEND_URL=https://app.<VPS_IP>.sslip.io

# WhatsApp provider.
#   mock     → simulated QR/connect flow (no real WhatsApp)
#   external → real WhatsApp via the bundled Baileys gateway service
WHATSAPP_PROVIDER=external
QR_SIMULATION=false         # only needed when WHATSAPP_PROVIDER=mock
WHATSAPP_SERVICE_URL=http://gateway:4000   # compose service; keep as-is
WHATSAPP_SERVICE_TOKEN=     # REQUIRED for external — generate: openssl rand -hex 32

# Email — console backend prints to worker/web logs; swap for SMTP in prod
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=FomoBot <noreply@fomobot.dev>

# SSL — sslip.io supports Let's Encrypt via certbot; keep false until certs exist
SECURE_SSL_REDIRECT=false

# Observability
SENTRY_DSN=
LOG_FORMAT=json
NGINX_PORT=8010             # host port the internal nginx binds to
WEB_WORKERS=2
